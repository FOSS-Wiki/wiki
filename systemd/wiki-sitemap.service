[Unit]
Description=Generate foss.wiki Sitemap
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
TimeoutStartSec=15min
ExecStart=/usr/bin/docker exec -u 1000:1000 production-wiki-mediawiki \
    php /var/www/wiki/mediawiki/maintenance/run.php generateSitemap \
    --memory-limit=50M \
    --fspath=/var/www/wiki/sitemap/ \
    --identifier=foss.wiki \
    --urlpath=/sitemap/ \
    --server=https://foss.wiki \
    --compress=yes \
    --skip-redirects
